{
    "name": "@omnifexit/omni-ui",
    "version": "0.2.5",
    "description": "Shared UI for the OmnifexIT dashboards.",
    "type": "module",
    "exports": {
        "./ui/*": "./src/ui/*.tsx",
        "./hooks/use-mobile": "./src/hooks/use-mobile.ts",
        "./icons": "./src/icons.ts",
        "./toast": "./src/toast.ts",
        "./url-state": "./src/url-state.ts",
        "./url-state/provider": "./src/url-state-provider.tsx",
        "./lib/utils": "./src/lib/utils.ts",
        "./theme.css": "./src/styles/theme.css",
        "./eslint": "./config/eslint.mjs",
        "./blocks/*": "./src/blocks/*.tsx",
        "./templates/*": "./src/templates/*.tsx",
        "./hooks/use-list-query": "./src/hooks/use-list-query.ts"
    },
    "files": [
        "src",
        "config"
    ],
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.64.0",
        "nuqs": "^2.8.0",
        "radix-ui": "^1.8.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0"
    },
    "peerDependencies": {
        "next": "^16.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "next": "^16.4.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.3",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0"
    }
}
